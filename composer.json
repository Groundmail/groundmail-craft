{
  "name": "groundmail/craft-plugin",
  "description": "Send Craft CMS email through the Groundmail API",
  "type": "craft-plugin",
  "license": "MIT",
  "keywords": [
    "craft",
    "craftcms",
    "craft-plugin",
    "mailer",
    "transport",
    "email",
    "groundmail"
  ],
  "authors": [
    {
      "name": "Groundmail",
      "homepage": "https://groundmail.dev"
    }
  ],
  "homepage": "https://groundmail.dev",
  "support": {
    "email": "support@groundmail.dev",
    "docs": "https://docs.groundmail.dev/integrations/craft",
    "issues": "https://github.com/Groundmail/groundmail-craft/issues",
    "source": "https://github.com/Groundmail/groundmail-craft"
  },
  "require": {
    "php": "^8.2",
    "craftcms/cms": "^5.0.0",
    "groundmail/symfony-mailer": "^0.8.4 || ^0.9"
  },
  "require-dev": {
    "phpunit/phpunit": "^10.5 || ^11.0"
  },
  "autoload": {
    "psr-4": {
      "groundmail\\craft\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "groundmail\\craft\\tests\\": "tests/unit/"
    }
  },
  "extra": {
    "name": "Groundmail",
    "handle": "groundmail",
    "developer": "Groundmail",
    "developerUrl": "https://groundmail.dev",
    "developerEmail": "support@groundmail.dev",
    "documentationUrl": "https://docs.groundmail.dev/integrations/craft",
    "changelogUrl": "https://raw.githubusercontent.com/Groundmail/groundmail-craft/main/CHANGELOG.md",
    "class": "groundmail\\craft\\Plugin"
  },
  "config": {
    "sort-packages": true,
    "allow-plugins": {
      "craftcms/plugin-installer": true,
      "yiisoft/yii2-composer": true
    }
  },
  "scripts": {
    "test": "phpunit"
  },
  "minimum-stability": "stable",
  "prefer-stable": true
}
